rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Shared customer inbox: signed-in dashboard users manage all submissions.

    match /customers/{customerId} {
      allow read, update, delete: if request.auth != null;

      // Landing-page submissions are create-only; no public read/update/delete.
      allow create: if (request.auth == null
        && request.resource.data.userId == "")
        || request.auth != null;
    }

    // ─── Users Collection ─────────────────────────────────────────
    // Users can read and update their own profile data.
    match /users/{userId} {
      allow read: if request.auth != null
        && (request.auth.uid == userId || isAdmin());
      allow write: if request.auth != null
        && request.auth.uid == userId;
    }

    // ─── Tasks Collection ─────────────────────────────────────────
    // Authenticated users can read/write tasks.
    match /tasks/{taskId} {
      allow read, write: if request.auth != null;
    }

    // ─── Folders Collection ────────────────────────────────────────
    // Folders organize documents and are shared across all users (no RLS).
    // The Document Manager role restriction for create/update/delete is
    // enforced at the application layer.
    match /folders/{folderId} {
      allow read, write: if request.auth != null;
    }

    // ─── Helper Functions ──────────────────────────────────────────
    function isAdmin() {
      return request.auth != null
        && 'roles' in request.auth.token
        && request.auth.token.roles.has('admin');
    }
  }
}
