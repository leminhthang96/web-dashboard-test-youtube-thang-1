rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Shared customer inbox: signed-in dashboard users manage all submissions.

    match /customers/{customerId} {
      allow read, update, delete: if request.auth != null;

      // Landing-page submissions are create-only; no public read/update/delete.
      allow create: if (request.auth == null
        && request.resource.data.userId == "")
        || request.auth != null;
    }

    // ─── Users Collection ─────────────────────────────────────────
    // Users can read and update their own profile data.
    match /users/{userId} {
      allow read: if request.auth != null
        && (request.auth.uid == userId || isAdmin());
      allow write: if request.auth != null
        && request.auth.uid == userId;
    }

    // ─── Tasks Collection ─────────────────────────────────────────
    // Only the creator may edit/delete; creator cannot be reassigned.
    match /tasks/{taskId} {
      function canReadTask() {
        return request.auth != null
          && (resource.data.get('createdBy', '') == request.auth.uid
            || resource.data.get('reporter', '') == request.auth.uid);
      }
      function validReporter() {
        return !('reporter' in request.resource.data)
          || (request.resource.data.reporter is string
            && request.resource.data.reporter.size() <= 128);
      }
      allow list: if canReadTask();
      // Create transactions must be able to check that a new ID is unused.
      allow get: if request.auth != null
        && (!exists(/databases/$(database)/documents/tasks/$(taskId))
          || canReadTask());
      allow create: if request.auth != null
        && request.resource.data.createdBy == request.auth.uid
        && validReporter();
      allow update: if request.auth != null
        && resource.data.createdBy == request.auth.uid
        && request.resource.data.createdBy == resource.data.createdBy
        && validReporter();
      allow delete: if request.auth != null
        && resource.data.createdBy == request.auth.uid;
    }

    // ─── Folders Collection ────────────────────────────────────────
    // Folders organize documents and are shared across all users (no RLS).
    // The Document Manager role restriction for create/update/delete is
    // enforced at the application layer.
    match /folders/{folderId} {
      allow read, write: if request.auth != null;
    }

    // ─── Helper Functions ──────────────────────────────────────────
    function isAdmin() {
      return request.auth != null
        && 'roles' in request.auth.token
        && request.auth.token.roles.has('admin');
    }
  }
}
